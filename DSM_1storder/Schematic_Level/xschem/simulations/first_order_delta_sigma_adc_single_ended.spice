** sch_path: /foss/designs/drms-elie3/2_ideal_circuits/first_order_delta_sigma_adc_single_ended.sch
**.subckt first_order_delta_sigma_adc_single_ended adaclout adaccout
*.opin adaclout
*.opin adaccout
Vin Vin GND SINE(1.5 0.8 625)
Vref Vref GND {Vref}
Vdd Vdd GND {Vdd}
Vcm Vcm GND {Vcm}
Vphi1 phi1 GND PULSE(0V 3V 0ns 0.1ns 0.1ns 0.4us 1us)
Vphi2 phi2 GND PULSE(0V 3V 0.5us 0.1ns 0.1ns 0.4us 1us)
Etrip trip GND Vdd GND {Etrip}
x1 Vdd Vin mod_out phi1 phi2 trip Vref Vcm GND ideal_modulator
x2 mod_out phi1 adaclout adaccout ideal_decimator samples={samples}
**** begin user architecture code


.param Etrip=0.5
.param Vref=3
.param Vdd=3
.param Vcm=Vdd/2
.param C1=0.25p C2=1p
.param samples=500




.temp 27
.control
option sparse
tran 100n 10ms 0 20n uic
save V(Vin) V(x1.Vint) V(mod_out)
*save V(adaclout) V(adaccout)
wrdata dsm_data.txt V(Vin) V(x1.Vint) V(mod_out)
plot V(Vin) V(x1.Vint) V(mod_out)

*ADC Output
*plot V(Vin) V(adaccout) V(adaclout)

.endc


**** end user architecture code
**.ends

